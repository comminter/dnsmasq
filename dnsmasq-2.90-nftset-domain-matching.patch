+	((*set)[0] == '4' && (query_flags & F_IPV4)) ||
+	((*set)[0] == '6' && (query_flags & F_IPV6)))
+      return 1;
+
+  return 0;
+}
+
+struct ipsets *domain_find_sets(struct ipsets *setlist, const char *domain,
+			       int nftset, unsigned int query_flags) {
   /* Similar algorithm to search_servers. */
